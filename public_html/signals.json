{
    "account.signup": {
        "label": "New user registration",
        "description": "A new user account was registered.",
        "category": "Members",
        "payload": {
            "user_id": "New user id",
            "email": "New account email address",
            "display_name": "New user display name",
            "source_user_id": "Acting user id (the new user)"
        },
        "notify": {
            "ntf_type": "account",
            "supports_topic": true,
            "default_email": true,
            "title_template": "New user registered: {display_name}",
            "body_template": "A new account was registered with email {email}.",
            "link_template": "/admin/admin_user?usr_user_id={user_id}"
        }
    },
    "newsletter.signup": {
        "label": "Newsletter signup",
        "description": "Someone subscribed to a mailing list / newsletter.",
        "category": "Members",
        "payload": {
            "mailing_list_id": "Mailing list id",
            "mailing_list_name": "Mailing list display name",
            "user_id": "Subscribing user id (nullable)",
            "source_user_id": "Acting user id (the subscriber)"
        },
        "notify": {
            "ntf_type": "account",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Newsletter signup: {mailing_list_name}",
            "body_template": "A user subscribed to the \"{mailing_list_name}\" mailing list.",
            "link_template": "/admin/admin_mailing_lists"
        }
    },
    "comment.posted": {
        "label": "New comment posted",
        "description": "A new comment was posted on a blog post.",
        "category": "Content",
        "payload": {
            "comment_id": "Comment id",
            "post_id": "Blog post id",
            "post_title": "Blog post title",
            "post_url": "Blog post URL",
            "comment_excerpt": "Comment body excerpt (truncated at the call site)",
            "author_name": "Comment author display name",
            "source_user_id": "Acting user id (the commenter)"
        },
        "notify": {
            "ntf_type": "comment",
            "supports_topic": true,
            "default_email": true,
            "title_template": "New comment by {author_name}",
            "body_template": "On \"{post_title}\": {comment_excerpt}",
            "link_template": "{post_url}"
        }
    },
    "purchase.completed": {
        "label": "Sale completed",
        "description": "A purchase or order was completed successfully.",
        "category": "Orders",
        "payload": {
            "order_id": "Order id",
            "user_id": "Buyer user id",
            "source_user_id": "Acting user id (the buyer)",
            "product_id": "Product id",
            "product_name": "Product display name",
            "buyer_name": "Buyer display name",
            "buyer_email": "Buyer email address",
            "amount": "Order total, decimal string",
            "currency": "Configured site currency"
        },
        "notify": {
            "ntf_type": "order",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Sale completed: {product_name}",
            "body_template": "{buyer_name} ({buyer_email}) completed a purchase — Order #{order_id}.",
            "link_template": "/admin/admin_orders"
        }
    },
    "payment.failed": {
        "label": "Payment failed",
        "description": "A checkout payment was declined or failed.",
        "category": "Orders",
        "payload": {
            "order_id": "Order id",
            "user_id": "Billing user id",
            "error_message": "Failure reason (truncated at the call site)"
        },
        "notify": {
            "ntf_type": "order",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Checkout payment failed",
            "body_template": "A card charge failed at checkout (Order #{order_id}): {error_message}",
            "link_template": "/admin/admin_orders"
        }
    },
    "subscription.started": {
