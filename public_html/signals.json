{
    "account.signup": {
        "label": "New user registration",
        "description": "A new user account was registered.",
        "category": "Members",
        "payload": {
            "user_id": "New user id",
            "email": "New account email address",
            "display_name": "New user display name",
            "source_user_id": "Acting user id (the new user)"
        },
        "notify": {
            "ntf_type": "account",
            "supports_topic": true,
            "default_email": true,
            "title_template": "New user registered: {display_name}",
            "body_template": "A new account was registered with email {email}.",
            "link_template": "/admin/admin_user?usr_user_id={user_id}"
        }
    },
    "newsletter.signup": {
        "label": "Newsletter signup",
        "description": "Someone subscribed to a mailing list / newsletter.",
        "category": "Members",
        "payload": {
            "mailing_list_id": "Mailing list id",
            "mailing_list_name": "Mailing list display name",
            "user_id": "Subscribing user id (nullable)",
            "source_user_id": "Acting user id (the subscriber)"
        },
        "notify": {
            "ntf_type": "account",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Newsletter signup: {mailing_list_name}",
            "body_template": "A user subscribed to the \"{mailing_list_name}\" mailing list.",
            "link_template": "/admin/admin_mailing_lists"
        }
    },
    "comment.posted": {
        "label": "New comment posted",
        "description": "A new comment was posted on a blog post.",
        "category": "Content",
        "payload": {
            "comment_id": "Comment id",
            "post_id": "Blog post id",
            "post_title": "Blog post title",
            "post_url": "Blog post URL",
            "comment_excerpt": "Comment body excerpt (truncated at the call site)",
            "author_name": "Comment author display name",
            "source_user_id": "Acting user id (the commenter)"
        },
        "notify": {
            "ntf_type": "comment",
            "supports_topic": true,
            "default_email": true,
            "title_template": "New comment by {author_name}",
            "body_template": "On \"{post_title}\": {comment_excerpt}",
            "link_template": "{post_url}"
        }
    },
    "event.registered": {
        "label": "Event registration",
        "description": "Someone registered for an event.",
        "category": "Events",
        "payload": {
            "event_id": "Event id",
            "product_id": "Product id",
            "product_name": "Product display name",
            "user_id": "Registrant user id",
            "registrant_name": "Registrant display name",
            "order_id": "Order id",
            "source_user_id": "Acting user id (the buyer)"
        },
        "notify": {
            "ntf_type": "event",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Event registration",
            "body_template": "{registrant_name} registered for {product_name}.",
            "link_template": "/admin/admin_events"
        }
    },
    "event.waitlisted": {
        "label": "Event waiting list join",
        "description": "Someone joined an event waiting list.",
        "category": "Events",
        "payload": {
            "event_id": "Event id",
            "event_name": "Event name",
            "user_id": "User id",
            "source_user_id": "Acting user id"
        },
        "notify": {
            "ntf_type": "event",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Waiting list join: {event_name}",
            "body_template": "Someone joined the waiting list for {event_name}.",
            "link_template": "/admin/admin_events"
        }
    },
    "event.withdrawn": {
        "label": "Event withdrawal",
        "description": "Someone withdrew from an event.",
        "category": "Events",
        "payload": {
            "event_id": "Event id",
            "event_name": "Event name",
            "user_id": "Withdrawing user id",
            "source_user_id": "Acting user id"
        },
        "notify": {
            "ntf_type": "event",
            "supports_topic": true,
            "default_email": true,
            "title_template": "Event withdrawal: {event_name}",
            "body_template": "A registrant withdrew from {event_name}.",
            "link_template": "/admin/admin_events"
        }
    }
}
