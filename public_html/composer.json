    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "ext-apcu": "*",
        "ext-sqlite3": "*",
        "stripe/stripe-php": "^10.16",
        "guzzlehttp/guzzle": "^7.4",
        "phpmailer/phpmailer": "^6.10.0",
        "spomky-labs/otphp": "^11.0",
        "chillerlan/php-qrcode": "^5.0",
        "bytestream/horde-imap-client": "^2.34",
        "smalot/pdfparser": "^2.0",
