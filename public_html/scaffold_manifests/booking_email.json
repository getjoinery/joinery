{
  "entity": "BookingEmail",
  "prefix": "bke",
  "plural": "booking_emails",
  "into": "plugins/bookings",
  "surfaces": ["data"],

  "delete": {
    "strategy": "soft",
    "foreign_key_actions": {
      "bke_bkn_booking_id": { "action": "cascade" }
    }
  },

  "fields": [
    { "name": "bkn_booking_id",     "type": "int8",         "required": true },
    { "name": "kind",               "type": "varchar(16)",  "required": true },
    { "name": "offset_minutes",     "type": "int4" },
    { "name": "booking_start_time", "type": "timestamp(6)", "required": true },
    { "name": "create_time",        "type": "timestamp(6)", "default": "now()" }
  ],

  "filters": [
    { "option": "booking_id", "column": "bke_bkn_booking_id", "bind": "int" },
    { "option": "kind",       "column": "bke_kind",           "bind": "str" }
  ]
}
