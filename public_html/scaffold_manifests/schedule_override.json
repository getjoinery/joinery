{
  "entity": "ScheduleOverride",
  "prefix": "sco",
  "plural": "schedule_overrides",
  "into": "core",
  "surfaces": ["data"],

  "delete": {
    "strategy": "soft",
    "foreign_key_actions": {
      "sco_sch_schedule_id": { "action": "cascade" }
    }
  },

  "fields": [
    { "name": "sch_schedule_id", "type": "int8", "required": true },
    { "name": "date",            "type": "date", "required": true },
    { "name": "start_time",      "type": "time" },
    { "name": "end_time",        "type": "time" }
  ],

  "filters": [
    { "option": "schedule_id", "column": "sco_sch_schedule_id", "bind": "int" },
    { "option": "date",        "column": "sco_date",            "bind": "str" }
  ]
}
