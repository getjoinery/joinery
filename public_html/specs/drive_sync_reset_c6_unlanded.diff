+/// Break a cycle of server renames this device owes, from inside one of them.
+///
+/// `held_by_a_rename_this_device_owes` makes a rename wait while the name it
+/// wants is held by something this device is renaming away. Right for a
+/// chain; wrong for a cycle. Two files trading names each hold the name the
+/// other wants, each is waiting for the other to leave, and neither ever
+/// does -- the planner breaks such a cycle by parking one member under a
+/// scratch name, but that park is made once, when the plan is written. A
+/// kill between the park and the moves that finish it, or a peer that put
+/// the park back (the reset's C6, kill2 75125 on folders and 75298 on files),
+/// leaves the moves queued with no park, and they wait on each other for
+/// ever.
+///
+/// So the rename that meets the wait asks where the chain goes: the holder
+/// of the name it wants, the name THAT holder's queued rename wants, that
+/// name's holder, and on, through this device's queue only. A chain that
+/// comes back to this entity is a cycle this device owns. The first member
+/// to run -- this op, since every member walks the same cycle -- parks the
+/// holder of its own target on the server under that holder's finisher's
+/// scratch name (the name its queued move recognises as its own park) and
+/// the caller then takes the vacated name in the same attempt. A two-member
+/// cycle is closed inside one executor run: the parked holder's finisher
+/// runs later in the same run and lands on the name this op vacated. A
+/// longer cycle is not: the queue is swept once per run, so a member whose
+/// target is still held when its turn comes waits a run, and each such
+/// member costs one pass boundary with the parked holder standing -- which
+/// is safe because no peer puts back another device's park (C10) or follows
+/// it onto a disk (C11).
+///
+/// The walk carries a visited set and ends within the queue's length. The
+/// park is sent under a key made from this op's key and the holder's id: the
+/// holder's own op sends later under its own key, and a replay after a crash
+/// asks for the same park again, which the server answers as done; the
+/// rename that follows then finds the name free. An encrypted FILE is never
+/// parked (its name is sealed and never collides); the cycle then waits, as
+/// before.
+fn break_a_rename_cycle(env: &ExecEnv, op: &Op, target: &Placement) -> Result<bool, ExecError> {
+    let queued = env.store.queued_ops()?;
+    let owed = |id: EntityId| -> Option<(&Op, Placement)> {
+        queued
+            .iter()
+            .filter(|o| o.entity == id && o.kind == "move_remote")
+            .find_map(|o| {
+                serde_json::from_str::<Value>(&o.params)
+                    .ok()
+                    .and_then(|p| read_place(&p).ok())
+                    .map(|to| (o, to))
+            })
+    };
+    let holder = |at: &Placement| -> Result<Option<Entry>, ExecError> {
+        Ok(env
+            .store
+            .children_of(at.parent)?
+            .into_iter()
+            .find(|e| e.remote.name == at.name && !e.remote_deleted))
+    };
+    let Some(first) = holder(target)? else {
+        return Ok(false);
+    };
+    if first.id == op.entity {
+        return Ok(false);
+    }
+    let Some((first_op, _)) = owed(first.id) else {
+        return Ok(false);
+    };
+    let mut visited: std::collections::HashSet<EntityId> = std::collections::HashSet::new();
+    visited.insert(op.entity);
+    let mut at = first.id;
+    let mut closes = false;
+    for _ in 0..=queued.len() {
+        if !visited.insert(at) {
+            break;
+        }
+        let Some((_, next)) = owed(at) else {
+            break;
+        };
+        match holder(&next)? {
+            Some(h) if h.id == op.entity => {
+                closes = true;
+                break;
+            }
+            Some(h) => at = h.id,
+            None => break,
+        }
+    }
+    if !closes || (first.is_encrypted && first.id.entity_type == EntityType::File) {
+        return Ok(false);
+    }
+    let scratch = crate::order::tagged_swap_name(
+        &env.store.park_tag(&first_op.idempotency_key)?,
+        &first_op.idempotency_key,
+    );
+    env.api.action_idempotent(
+        "drive_rename",
+        json!({
+            "entity_type": first.id.entity_type.to_string(),
+            "entity_id": first.id.server_id,
+            "name": scratch,
+        }),
+        &format!("{}-cycle-park-{}", op.idempotency_key, first.id.server_id),
+    )?;
+    let mut parked = first;
+    parked.remote.name = scratch;
+    env.store.put_entry(&parked)?;
+    Ok(true)
+}
