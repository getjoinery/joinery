/// A trade whose cycle-breaking park never happened still finishes (the
/// reset's C6).
///
/// The planner breaks a rename cycle by parking one member under a scratch
/// name, once, when it writes the plan. Lose that park -- a kill that drops it,
/// a peer that put it back -- and the two renames that finish the trade are
/// left queued, each waiting for a name the other holds, each "spoken for by
/// something this device is renaming", for ever (kill2 75125 on folders,
/// plain2 75298 on files). Here the park is lost by marking it done without
/// running it, the plainest way to say "the park is gone and the finishers are
/// still queued". Asserted as the invariant: the trade ends with each side
/// under the other's name on the server and on every disk, no scratch name
/// anywhere, no conflict name minted, and the device goes quiet.
fn lose_the_planned_park(build: impl Fn() -> World, device: &str) -> World {
    // The death has to land after the plan is written and before the park is
    // answered, and where that falls in the pass is not this test's to know,
    // so it is found.
    let world = (0..60u64)
        .find_map(|die_after| {
            let world = build();
            let d = world.device(device);
            d.net.arm_death(die_after);
            world.pass(d);
            let queued = d.store.queued_ops().unwrap();
            let parked = queued.iter().any(|o| o.kind == "park_remote");
            let finishers = queued.iter().filter(|o| o.kind == "move_remote").count() >= 2;
            (parked && finishers).then_some(world)
        })
        .expect("no arming left the planner's park and its finishers queued");
    let d = world.device(device);
    for op in d.store.queued_ops().unwrap() {
        if op.kind == "park_remote" {
            d.store.set_op_state(op.op_id, jd_core::store::OpState::Done).unwrap();
        }
    }
    world
}

fn no_scratch_and_no_conflict_names(world: &World) {
    let tree = world.server.tree();
    assert!(!tree.keys().any(|p| p.contains(".jd-") || p.contains("conflicted copy")), "{tree:?}");
    for d in &world.devices {
        assert!(!d.fs.all_paths().iter().any(|p| p.contains(".jd-") || p.contains("conflicted copy")), "{}: {:?}", d.name, d.fs.all_paths());
    }
}

#[test]
fn two_folders_trading_names_finish_when_the_planned_park_is_lost() {
    let world = lose_the_planned_park(
        || {
            let world = World::new(9_253, &["mac", "pc"]);
            let mac = world.device("mac");
            mac.fs.user_mkdir("ring-1");
            mac.fs.user_mkdir("ring-2");
            mac.fs.user_write("ring-1/one.txt", b"one");
            mac.fs.user_write("ring-2/two.txt", b"two");
            assert!(world.settle().is_some());
            mac.fs.user_rename("ring-1", ".swap.tmp");
            mac.fs.user_rename("ring-2", "ring-1");
            mac.fs.user_rename(".swap.tmp", "ring-2");
            world
        },
        "mac",
    );
    assert!(world.settle().is_some(), "the two renames waited on each other for ever");
    assert_converged(&world);
    let tree = world.server.tree();
    assert_eq!(tree.get("ring-2/one.txt").cloned().flatten(), Some(jd_sim::sha256_hex(b"one")), "{tree:?}");
    assert_eq!(tree.get("ring-1/two.txt").cloned().flatten(), Some(jd_sim::sha256_hex(b"two")), "{tree:?}");
    no_scratch_and_no_conflict_names(&world);
}

#[test]
fn two_files_trading_names_finish_when_the_planned_park_is_lost() {
    let one = b"the contents of A";
    let two = b"the contents of B";
    let world = lose_the_planned_park(
        || {
            let world = World::of(9_254, &[("a", jd_sim::Platform::MacOs), ("b", jd_sim::Platform::MacOs)]);
            let a = world.device("a");
            a.fs.user_mkdir("One");
            a.fs.user_mkdir("Two");
            a.fs.user_write("One/x.txt", one);
            a.fs.user_write("Two/y.txt", two);
            assert!(world.settle().is_some());
            a.fs.user_rename("One/x.txt", "Two/held");
            a.fs.user_rename("Two/y.txt", "One/X.txt");
            a.fs.user_rename("Two/held", "Two/Y.txt");
            world
        },
        "a",
    );
    assert!(world.settle().is_some(), "the two renames waited on each other for ever");
    assert_converged(&world);
    let tree = world.server.tree();
    assert_eq!(tree.get("One/X.txt").cloned().flatten(), Some(jd_sim::sha256_hex(two)), "{tree:?}");
    assert_eq!(tree.get("Two/Y.txt").cloned().flatten(), Some(jd_sim::sha256_hex(one)), "{tree:?}");
    no_scratch_and_no_conflict_names(&world);
}

/// Three folders rotating names with the park lost: a cycle longer than two
/// is not closed inside one executor run (the queue is swept once a run), so
/// it converges over a few passes with a park standing between them. Asserted
/// as the end state only.
#[test]
fn three_folders_rotating_names_finish_when_the_planned_park_is_lost() {
    let world = lose_the_planned_park(
        || {
            let world = World::new(9_255, &["mac", "pc"]);
            let mac = world.device("mac");
            for (d, f) in [("ring-1", "one"), ("ring-2", "two"), ("ring-3", "three")] {
                mac.fs.user_mkdir(d);
                mac.fs.user_write(&format!("{d}/{f}.txt"), f.as_bytes());
            }
            assert!(world.settle().is_some());
            mac.fs.user_rename("ring-1", ".swap.tmp");
            mac.fs.user_rename("ring-2", "ring-1");
            mac.fs.user_rename("ring-3", "ring-2");
            mac.fs.user_rename(".swap.tmp", "ring-3");
            world
        },
        "mac",
    );
    assert!(world.settle().is_some(), "the rotation waited on itself for ever");
    assert_converged(&world);
    let tree = world.server.tree();
    assert_eq!(tree.get("ring-3/one.txt").cloned().flatten(), Some(jd_sim::sha256_hex(b"one")), "{tree:?}");
    assert_eq!(tree.get("ring-1/two.txt").cloned().flatten(), Some(jd_sim::sha256_hex(b"two")), "{tree:?}");
    assert_eq!(tree.get("ring-2/three.txt").cloned().flatten(), Some(jd_sim::sha256_hex(b"three")), "{tree:?}");
    no_scratch_and_no_conflict_names(&world);
}

