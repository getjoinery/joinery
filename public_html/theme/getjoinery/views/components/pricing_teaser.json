{
    "title": "Pricing Teaser",
    "description": "Compact 3-tier pricing preview with link to full pricing page",
    "category": "pricing",
    "config_schema": {
        "fields": [
            {
                "name": "heading",
                "label": "Heading",
                "type": "textinput"
            },
            {
                "name": "subheading",
                "label": "Subheading",
                "type": "textarea",
                "default": "All features included on every plan. No transaction fees. No surprises."
            },
            {
                "name": "tier1_name",
                "label": "Tier 1 Name",
                "type": "textinput"
            },
            {
                "name": "tier1_price",
                "label": "Tier 1 Price",
                "type": "textinput",
                "default": "$29"
            },
            {
                "name": "tier1_note",
                "label": "Tier 1 Note",
                "type": "textinput"
            },
            {
                "name": "tier2_name",
                "label": "Tier 2 Name",
                "type": "textinput"
            },
            {
                "name": "tier2_price",
                "label": "Tier 2 Price",
                "type": "textinput",
                "default": "$59"
            },
            {
                "name": "tier2_note",
                "label": "Tier 2 Note",
                "type": "textinput"
            },
            {
                "name": "tier3_name",
                "label": "Tier 3 Name",
                "type": "textinput"
            },
            {
                "name": "tier3_price",
                "label": "Tier 3 Price",
                "type": "textinput",
                "default": "$99"
            },
            {
                "name": "tier3_note",
                "label": "Tier 3 Note",
                "type": "textinput"
            },
            {
                "name": "link_text",
                "label": "Link Text",
                "type": "textinput"
            },
            {
                "name": "link_url",
                "label": "Link URL",
                "type": "textinput",
                "default": "/pricing"
            },
            {
                "name": "tier1_suffix",
                "label": "Tier 1 Price Suffix",
                "type": "textinput",
                "advanced": true
            },
            {
                "name": "tier2_suffix",
                "label": "Tier 2 Price Suffix",
                "type": "textinput",
                "advanced": true
            },
            {
                "name": "tier3_suffix",
                "label": "Tier 3 Price Suffix",
                "type": "textinput",
                "advanced": true
            },
            {
                "name": "price_suffix",
                "label": "Default Price Suffix",
                "type": "textinput",
                "default": "/mo",
                "advanced": true
            },
            {
                "name": "featured_tier",
                "label": "Highlighted Tier",
                "type": "select",
                "options": {
                    "1": "First",
                    "2": "Second",
                    "3": "Third",
                    "0": "None"
                },
                "default": "2",
                "advanced": true
            }
        ]
    }
}