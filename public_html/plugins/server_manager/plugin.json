{
    "name": "Server Manager",
    "version": "1.7.11",
    "description": "Remote server management for Joinery instances",
    "author": "Joinery",
    "receives_upgrades": true,
    "included_in_publish": true,
    "styles": ["assets/css/server_manager.css"],
    "adminMenu": [
        {
            "slug": "server-manager",
            "title": "Server Manager",
            "icon": "server",
            "permission": 10,
            "order": 14,
            "items": [
                { "slug": "server-manager-dashboard", "title": "Dashboard", "url": "/admin/server_manager", "order": 1 },
                { "slug": "server-manager-upgrades", "title": "Upgrades", "url": "/admin/server_manager/publish_upgrade", "order": 2 },
                { "slug": "server-manager-targets", "title": "Remote Backup", "url": "/admin/server_manager/targets", "order": 3 },
                { "slug": "server-manager-provisioning", "title": "Provisioning", "url": "/admin/server_manager/provisioning_setup", "order": 5 },
                { "slug": "server-manager-jobs", "title": "Jobs", "url": "/admin/server_manager/jobs", "order": 6 },
                { "slug": "server-manager-cloud-connect", "title": "Cloud Connect", "url": "/profile/server_manager/connect_cloud", "order": 8 },
                { "slug": "system-specs", "title": "Specifications", "url": "/admin/server_manager/specs", "order": 7 }
            ]
        },
        {
            "slug": "system-marketplace",
            "title": "Marketplace",
            "url": "/admin/server_manager/marketplace",
            "permission": 8,
            "icon": "store",
            "parent": "server-manager",
            "order": 4
        }
    ],
    "settings": [
        { "name": "server_manager_getjoinery_api_url",              "default": "" },
        { "name": "server_manager_getjoinery_api_public_key",       "default": "" },
        { "name": "server_manager_getjoinery_api_secret_key",       "default": "" },
        { "name": "server_manager_provisioning_admin_alert_email",  "default": "" },
        { "name": "server_manager_provisioning_welcome_from_email", "default": "" },
        { "name": "server_manager_provisioning_welcome_from_name",  "default": "" },
        { "name": "server_manager_provisioning_domain_question_id", "default": "" },
        { "name": "server_manager_cert_expiry_warn_days",           "default": "21" },
        { "name": "server_manager_linode_referral_url",             "default": "", "helptext": "Linode referral URL shown on the Connect page's create-account link. New accounts signed up through it receive Linode's referral credit." },
        { "name": "server_manager_customer_cloud_ssh_key_path",     "default": "", "helptext": "Private key path the management agent uses for customer-cloud nodes; its .pub sibling is installed on created instances via authorized_keys. Required for customer-cloud provisioning." },
        { "name": "server_manager_customer_cloud_region",           "default": "us-southeast", "helptext": "Default region for customer-cloud instances." },
        { "name": "server_manager_customer_cloud_type",             "default": "g6-nanode-1", "helptext": "Default instance type for customer-cloud instances." },
        { "name": "server_manager_customer_cloud_image",            "default": "linode/ubuntu24.04", "helptext": "OS image for customer-cloud instances. Must be an Ubuntu LTS the installer supports." }
    ]
}
