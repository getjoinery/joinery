{
    "name": "Server Manager",
    "version": "1.3.4",
    "description": "Remote server management for Joinery instances",
    "author": "Joinery",
    "receives_upgrades": true,
    "included_in_publish": true,
    "styles": ["assets/css/server_manager.css"],
    "adminMenu": [
        {
            "slug": "server-manager",
            "title": "Server Manager",
            "icon": "server",
            "permission": 10,
            "order": 14,
            "items": [
                { "slug": "server-manager-dashboard", "title": "Dashboard", "url": "/admin/server_manager", "order": 1 },
                { "slug": "server-manager-upgrades", "title": "Upgrades", "url": "/admin/server_manager/publish_upgrade", "order": 2 },
                { "slug": "server-manager-targets", "title": "Remote Backup", "url": "/admin/server_manager/targets", "order": 3 },
                { "slug": "server-manager-jobs", "title": "Jobs", "url": "/admin/server_manager/jobs", "order": 6 },
                { "slug": "system-specs", "title": "Specifications", "url": "/admin/server_manager/specs", "order": 7 }
            ]
        },
        {
            "slug": "system-marketplace",
            "title": "Marketplace",
            "url": "/admin/server_manager/marketplace",
            "permission": 8,
            "icon": "store",
            "parent": "server-manager",
            "order": 4
        }
    ],
    "settings": [
        { "name": "server_manager_getjoinery_api_url",              "default": "" },
        { "name": "server_manager_getjoinery_api_public_key",       "default": "" },
        { "name": "server_manager_getjoinery_api_secret_key",       "default": "" },
        { "name": "server_manager_provisioning_admin_alert_email",  "default": "" },
        { "name": "server_manager_provisioning_welcome_from_email", "default": "" },
        { "name": "server_manager_provisioning_welcome_from_name",  "default": "" },
        { "name": "server_manager_provisioning_domain_question_id", "default": "" },
        { "name": "server_manager_cert_expiry_warn_days",           "default": "21" }
    ]
}
