{
    "name": "Inbound Email",
    "description": "Self-hosted inbound email: forwarding, local mailboxes, DKIM/SRS",
    "version": "1.25.0",
    "author": "Joinery",
    "receives_upgrades": true,
    "included_in_publish": true,
    "requires": {
        "php": ">=8.0"
    },
    "tags": [
        "email",
        "inbound",
        "forwarding",
        "smtp"
    ],
    "styles": [
        "assets/mailbox_reader.css",
        "assets/css/inbound_email.css"
    ],
    "storage_profiles": [
        "RawMessageStore"
    ],
    "adminMenu": [
        {
            "slug": "incoming",
            "title": "Incoming",
            "url": "/plugins/inbound_email/admin/admin_inbound_email_reader",
            "parent": "emails",
            "permission": 5,
            "order": 10
        }
    ],
    "profileMenu": [
        {
            "slug": "inbound-email-mailbox",
            "title": "Email",
            "url": "/profile/inbound_email/mailbox",
            "nativeScreen": "mailbox",
            "icon": "envelope",
            "visibility": "in",
            "permission": 0,
            "order": 58
        }
    ],
    "provisioners": [
        {
            "key": "inbound_mail_server",
            "label": "Inbound mail server",
            "details": "Provider-specific. For Postfix, verifies port 25 is listening locally. For webhook providers (Mailgun, etc.) this is informational — the provider's own infrastructure handles MX.",
            "check": {
                "type": "code",
                "call": "InboundEmailHealth::checkInboundMailServer"
            },
            "script": "provisioning/install_email.sh"
        },
        {
            "key": "outbound_forwarding_relay",
            "label": "Outbound mail relay for forwarding",
            "details": "Forwarded messages are relayed out through this SMTP server.",
            "check": {
                "type": "code",
                "call": "InboundEmailHealth::checkForwardingRelay"
            }
        },
        {
            "key": "domain_dns_records",
            "label": "DNS records for inbound domains",
            "details": "Each enabled inbound domain needs an MX record pointing here and an SPF record.",
            "check": {
                "type": "code",
                "call": "InboundEmailHealth::checkDomainDns"
            }
        },
        {
            "key": "content_spam_scanner",
            "label": "Content spam scanner (rspamd)",
            "details": "Optional. rspamd milter scores inbound mail for content spam and stamps X-Spam; the router reads it into the spam verdict. Webhook providers supply their own spam signal instead.",
            "check": {
                "type": "code",
                "call": "InboundEmailHealth::checkContentSpamScanner"
            },
            "script": "provisioning/install_email.sh"
        }
    ],
    "settings": [
        {
            "name": "inbound_email_enabled",
            "default": "0"
        },
        {
            "name": "inbound_email_from_show_via",
            "default": "1"
        },
        {
            "name": "inbound_email_log_retention_days",
            "default": "30"
        },
        {
            "name": "inbound_email_forwarding_max_destinations",
            "default": "10"
        },
        {
            "name": "inbound_email_forwarding_rate_limit_per_alias",
            "default": "50"
        },
        {
            "name": "inbound_email_forwarding_rate_limit_per_domain",
            "default": "200"
        },
        {
            "name": "inbound_email_forwarding_rate_limit_window",
            "default": "3600"
        },
        {
            "name": "inbound_email_srs_enabled",
            "default": "0"
        },
        {
            "name": "inbound_email_srs_secret",
            "default": ""
        },
        {
            "name": "inbound_email_mail_hostname",
            "default": ""
        },
        {
            "name": "inbound_email_public_ip",
            "default": ""
        },
        {
            "name": "inbound_email_forwarding_smtp_host",
            "default": ""
        },
        {
            "name": "inbound_email_forwarding_smtp_port",
            "default": ""
        },
        {
            "name": "inbound_email_forwarding_smtp_username",
            "default": ""
        },
        {
            "name": "inbound_email_forwarding_smtp_password",
            "default": ""
        },
        {
            "name": "inbound_email_mailbox_retention_days",
            "default": "14"
        },
        {
            "name": "inbound_email_mailbox_max_per_window",
            "default": "500"
        },
        {
            "name": "inbound_email_provider",
            "default": "postfix"
        },
        {
            "name": "inbound_email_spam_filtering_enabled",
            "default": "0"
        },
        {
            "name": "inbound_email_content_spam_filtering_enabled",
            "default": "0"
        },
        {
            "name": "inbound_email_rspamd_controller_url",
            "default": "http://127.0.0.1:11334"
        }
    ]
}
