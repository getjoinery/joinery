{
    "name": "Store",
    "version": "1.4.0",
    "description": "Sell products: cart, checkout, orders, coupons, Stripe/PayPal, Apple/Google mobile billing, recurring subscriptions, billing portal, and product requirements",
    "author": "Joinery",
    "license": "Joinery-Commercial",
    "requires_entitlement": true,
    "receives_upgrades": true,
    "included_in_publish": true,
    "requires": {
        "php": ">=8.0"
    },
    "adminMenu": [
        {
            "slug": "orders",
            "title": "Orders",
            "icon": "shopping-cart",
            "order": 4,
            "permission": 5,
            "settingActivate": "products_active",
            "items": [
                {
                    "slug": "orders-list",
                    "title": "Orders list",
                    "url": "/plugins/store/admin/admin_orders",
                    "order": 1,
                    "permission": 5,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "stripe-payments",
                    "title": "Stripe Payments",
                    "url": "/plugins/store/admin/admin_stripe_orders",
                    "order": 2,
                    "permission": 5,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "shadow-sessions",
                    "title": "Shadow Sessions",
                    "url": "/plugins/store/admin/admin_shadow_sessions",
                    "order": 15,
                    "permission": 5,
                    "settingActivate": "products_active"
                }
            ]
        },
        {
            "slug": "products",
            "title": "Products",
            "icon": "box",
            "order": 3,
            "permission": 8,
            "settingActivate": "products_active",
            "items": [
                {
                    "slug": "products-list",
                    "title": "Products list",
                    "url": "/plugins/store/admin/admin_products",
                    "order": 1,
                    "permission": 8,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "product-groups",
                    "title": "Product Groups",
                    "url": "/plugins/store/admin/admin_product_groups",
                    "order": 2,
                    "permission": 9,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "coupon-codes",
                    "title": "Coupon codes",
                    "url": "/plugins/store/admin/admin_coupon_codes",
                    "order": 10,
                    "permission": 5,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "ownership",
                    "title": "Ownership",
                    "url": "/plugins/store/admin/admin_ownerships",
                    "order": 11,
                    "permission": 5,
                    "settingActivate": "products_active"
                },
                {
                    "slug": "mobile-store-products",
                    "title": "Mobile Store Products",
                    "url": "/plugins/store/admin/admin_store_product_mappings",
                    "order": 12,
                    "permission": 8,
                    "settingActivate": "subscriptions_active"
                }
            ]
        }
    ],
    "settingsMenu": [
        {
            "slug": "store-billing",
            "title": "Billing",
            "url": "/profile/billing",
            "order": 80,
            "permission": 0,
            "icon": "credit-card",
            "settingActivate": "products_active"
        },
        {
            "slug": "store-settings-orders",
            "title": "Orders",
            "url": "/profile/orders",
            "order": 82,
            "permission": 0,
            "icon": "shopping-bag",
            "settingActivate": "products_active"
        },
        {
            "slug": "store-settings-subs",
            "title": "Subscriptions",
            "url": "/profile/subscriptions",
            "order": 84,
            "permission": 0,
            "icon": "refresh",
            "settingActivate": "subscriptions_active"
        }
    ],
    "settingsMirrorGroups": [
        "debug"
    ],
    "settingsGroups": {
        "storefront": "Storefront",
        "stripe": "Stripe",
        "paypal": "PayPal",
        "subscriptions": "Subscriptions",
        "mobile": "Mobile in-app purchases",
        "donations": "Donations"
    },
    "settings": [
        {
            "name": "products_active",
            "default": "1",
            "legacy_core": true,
            "group": "storefront",
            "label": "Products enabled",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "products_list_items_active",
            "default": "1",
            "legacy_core": true,
            "group": "storefront",
            "label": "Show products in item lists",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "coupons_active",
            "default": "1",
            "legacy_core": true,
            "group": "storefront",
            "label": "Coupons enabled",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscriptions_active",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Subscriptions enabled",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "checkout_type",
            "default": "stripe_regular",
            "legacy_core": true,
            "group": "storefront",
            "label": "Checkout style",
            "type": "select",
            "options": {
                "stripe_regular": "Stripe — card fields on the site",
                "stripe_checkout": "Stripe — hosted checkout page",
                "none": "No card payments"
            },
            "helptext": "Which of these the checkout offers. Readers of this setting understand stripe_regular and stripe_checkout; none turns card payment off."
        },
        {
            "name": "cart_intermediate_page",
            "default": "1",
            "legacy_core": true,
            "group": "storefront",
            "label": "Show a cart page before checkout",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            },
            "helptext": "Off sends the buyer straight from Add to Cart into checkout."
        },
        {
            "name": "site_currency",
            "default": "usd",
            "legacy_core": true,
            "group": "storefront",
            "label": "Currency",
            "helptext": "An ISO code. It picks the symbol prices render with; adding one means adding it to CurrencyHelper too.",
            "options": {
                "usd": "US Dollar",
                "eur": "Euro"
            },
            "type": "select"
        },
        {
            "name": "use_paypal_checkout",
            "default": "0",
            "legacy_core": true,
            "group": "paypal",
            "label": "Offer PayPal at checkout",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "use_venmo_checkout",
            "default": "0",
            "legacy_core": true,
            "group": "paypal",
            "label": "Offer Venmo at checkout",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            },
            "helptext": "Requires PayPal to be on."
        },
        {
            "name": "pricing_page",
            "default": "1",
            "legacy_core": true,
            "group": "storefront",
            "label": "Show the pricing page",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "max_subscriptions_per_user",
            "default": "10",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Max subscriptions per member",
            "type": "number",
            "validation": {
                "number": true,
                "min": 1,
                "messages": {
                    "min": "Must be 1 or more."
                }
            }
        },
        {
            "name": "subscription_cancellation_enabled",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Members can cancel",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscription_cancellation_prorate",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Refund the unused part on cancellation",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscription_cancellation_timing",
            "default": "Immediate",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Cancellation takes effect",
            "type": "select",
            "options": {
                "Immediate": "Immediately",
                "End of period": "At the end of the billing period"
            }
        },
        {
            "name": "subscription_downgrade_prorate",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Credit the unused part on downgrade",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscription_downgrade_timing",
            "default": "Immediate",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Downgrade takes effect",
            "type": "select",
            "options": {
                "Immediate": "Immediately",
                "End of period": "At the end of the billing period"
            }
        },
        {
            "name": "subscription_downgrades_enabled",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Members can downgrade",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscription_reactivation_enabled",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Members can reactivate a cancelled subscription",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "subscription_upgrade_prorate",
            "default": "1",
            "legacy_core": true,
            "group": "subscriptions",
            "label": "Charge only the difference on upgrade",
            "type": "select",
            "options": {
                "1": "Yes",
                "0": "No"
            }
        },
        {
            "name": "stripe_api_key",
            "default": "",
            "legacy_core": true,
            "group": "stripe",
            "label": "Stripe publishable key",
            "type": "text",
            "validation": {
                "pattern": "#^pk_(live|test)_[a-zA-Z0-9]{24,}$#",
                "messages": {
                    "pattern": "Must start with pk_live_ or pk_test_ (not sk_)"
                }
            },
            "helptext": "Starts with pk_live_ or pk_test_. Not the secret key."
        },
        {
            "name": "stripe_api_key_test",
            "default": "",
            "legacy_core": true,
            "group": "stripe",
            "label": "Test Stripe publishable key",
            "type": "text",
            "validation": {
                "pattern": "#^pk_(live|test)_[a-zA-Z0-9]{24,}$#",
                "messages": {
                    "pattern": "Must start with pk_live_ or pk_test_ (not sk_)"
                }
            },
            "helptext": "Starts with pk_test_."
        },
        {
            "name": "stripe_api_pkey",
            "default": "",
            "legacy_core": true,
            "secret": true,
            "group": "stripe",
            "label": "Stripe secret key",
            "validation": {
                "pattern": "#^sk_(live|test)_[a-zA-Z0-9]{24,}$#",
                "messages": {
                    "pattern": "Must start with sk_live_ or sk_test_ (not pk_)"
                }
            },
            "helptext": "Starts with sk_live_ or sk_test_. Not the publishable key."
        },
        {
            "name": "stripe_api_pkey_test",
            "default": "",
            "legacy_core": true,
            "secret": true,
            "group": "stripe",
            "label": "Test Stripe secret key",
            "validation": {
                "pattern": "#^sk_(live|test)_[a-zA-Z0-9]{24,}$#",
                "messages": {
                    "pattern": "Must start with sk_live_ or sk_test_ (not pk_)"
                }
            },
            "helptext": "Starts with sk_test_."
        },
        {
            "name": "stripe_endpoint_secret",
            "default": "",
            "legacy_core": true,
            "secret": true,
            "group": "stripe",
            "label": "Stripe Endpoint Secret",
            "helptext": "Signing secret for the Stripe webhook, from the Stripe dashboard."
        },
        {
            "name": "store_optional_donation_product_id",
            "default": "",
            "helptext": "Product added to the cart when a buyer enters an optional donation amount alongside another purchase. Blank turns the piggyback-donation feature off.",
            "group": "donations",
            "label": "Optional donation product",
            "type": "select",
            "options_from": "StoreSettingOptions::donationProducts",
            "empty_option": false,
            "options_include": "plugins/store/includes/StoreSettingOptions.php"
        },
        {
            "name": "paypal_api_key",
            "default": "",
            "legacy_core": true,
            "group": "paypal",
            "label": "PayPal client id",
            "type": "text"
        },
        {
            "name": "paypal_api_key_test",
            "default": "",
            "legacy_core": true,
            "group": "paypal",
            "label": "Test PayPal client id",
            "type": "text"
        },
        {
            "name": "paypal_api_secret",
            "default": "",
            "legacy_core": true,
            "secret": true,
            "group": "paypal",
            "label": "PayPal client secret"
        },
        {
            "name": "paypal_api_secret_test",
            "default": "",
            "legacy_core": true,
            "secret": true,
            "group": "paypal",
            "label": "Test PayPal client secret"
        },
        {
            "name": "store_paypal_webhook_id",
            "default": "",
            "group": "paypal",
            "label": "PayPal webhook id",
            "helptext": "From the PayPal developer dashboard, next to the webhook you created for this site. Without it PayPal webhooks are rejected, so subscription renewals and cancellations are never recorded.",
            "type": "text"
        },
        {
            "name": "store_paypal_webhook_id_test",
            "default": "",
            "group": "paypal",
            "label": "Test PayPal webhook id",
            "helptext": "The sandbox webhook id. Used whenever the store is in test mode.",
            "type": "text"
        },
        {
            "name": "store_app_store_issuer_id",
            "default": "",
            "group": "mobile",
            "label": "App Store issuer id",
            "type": "text"
        },
        {
            "name": "store_app_store_key_id",
            "default": "",
            "group": "mobile",
            "label": "App Store key id",
            "type": "text"
        },
        {
            "name": "store_app_store_private_key",
            "default": "",
            "secret": true,
            "group": "mobile",
            "label": "App Store private key",
            "type": "textarea",
            "rows": 4
        },
        {
            "name": "store_app_store_bundle_ids",
            "default": "",
            "group": "mobile",
            "label": "App Store bundle ids",
            "type": "text",
            "helptext": "Comma-separated."
        },
        {
            "name": "store_play_package_names",
            "default": "",
            "group": "mobile",
            "label": "Play package names",
            "type": "text",
            "helptext": "Comma-separated."
        },
        {
            "name": "store_play_service_account_json",
            "default": "",
            "secret": true,
            "group": "mobile",
            "label": "Play service account JSON",
            "type": "textarea",
            "rows": 4
        },
        {
            "name": "store_play_rtdn_audience",
            "default": "",
            "group": "mobile",
            "label": "Play RTDN audience",
            "type": "text",
            "helptext": "Expected audience claim on real-time developer notifications."
        }
    ],
    "signals": {
        "purchase.completed": {
            "label": "Sale completed",
            "description": "A purchase or order was completed successfully.",
            "category": "Orders",
            "payload": {
                "order_id": "Order id",
                "user_id": "Buyer user id",
                "source_user_id": "Acting user id (the buyer)",
                "product_id": "Product id",
                "product_name": "Product display name",
                "buyer_name": "Buyer display name",
                "buyer_email": "Buyer email address",
                "amount": "Order total, decimal string",
                "currency": "Configured site currency"
            },
            "notify": {
                "ntf_type": "order",
                "supports_topic": true,
                "default_email": true,
                "title_template": "Sale completed: {product_name}",
                "body_template": "{buyer_name} ({buyer_email}) completed a purchase — Order #{order_id}.",
                "link_template": "/plugins/store/admin/admin_orders"
            }
        },
        "payment.failed": {
            "label": "Payment failed",
            "description": "A checkout payment was declined or failed.",
            "category": "Orders",
            "payload": {
                "order_id": "Order id",
                "user_id": "Billing user id",
                "error_message": "Failure reason (truncated at the call site)"
            },
            "notify": {
                "ntf_type": "order",
                "supports_topic": true,
                "default_email": true,
                "title_template": "Checkout payment failed",
                "body_template": "A card charge failed at checkout (Order #{order_id}): {error_message}",
                "link_template": "/plugins/store/admin/admin_orders"
            }
        },
        "subscription.started": {
            "label": "New subscription",
            "description": "A new subscriber signed up for a subscription or tier.",
            "category": "Subscriptions",
            "payload": {
                "order_id": "Order id",
                "order_item_id": "Order item id",
                "user_id": "Subscriber user id",
                "source_user_id": "Acting user id (the subscriber)",
                "product_id": "Product id",
                "product_name": "Product display name",
                "buyer_name": "Subscriber display name",
                "buyer_email": "Subscriber email address"
            },
            "notify": {
                "ntf_type": "subscription",
                "supports_topic": true,
                "default_email": true,
                "title_template": "New subscription: {product_name}",
                "body_template": "{buyer_name} ({buyer_email}) started a subscription — Order #{order_id}.",
                "link_template": "/plugins/store/admin/admin_orders"
            }
        },
        "subscription.cancelled": {
            "label": "Subscription cancelled",
            "description": "A subscription was cancelled by the user or the provider.",
            "category": "Subscriptions",
            "payload": {
                "order_item_id": "Order item id",
                "user_id": "Subscriber user id",
                "provider": "Payment provider (stripe / paypal)",
                "provider_subscription_id": "Provider-side subscription id"
            },
            "notify": {
                "ntf_type": "subscription",
                "supports_topic": true,
                "default_email": true,
                "title_template": "Subscription cancelled",
                "body_template": "A subscription was cancelled ({provider} subscription {provider_subscription_id}).",
                "link_template": "/admin/admin_subscription_tiers"
            }
        },
        "subscription.payment_failed": {
            "label": "Subscription payment failed",
            "description": "A recurring subscription charge failed or went past-due.",
            "category": "Subscriptions",
            "payload": {
                "order_item_id": "Order item id",
                "user_id": "Subscriber user id",
                "provider": "Payment provider (stripe / paypal)",
                "provider_subscription_id": "Provider-side subscription id"
            },
            "notify": {
                "ntf_type": "subscription",
                "supports_topic": true,
                "default_email": true,
                "title_template": "Subscription payment failed",
                "body_template": "A recurring subscription payment failed ({provider} subscription {provider_subscription_id}).",
                "link_template": "/plugins/store/admin/admin_orders"
            }
        },
        "subscription.expired": {
            "label": "Subscription expired",
            "description": "A subscription or tier lapsed.",
            "category": "Subscriptions",
            "payload": {
                "user_id": "Subscriber user id",
                "tier_id": "Subscription tier id",
                "tier_name": "Subscription tier name"
            },
            "notify": {
                "ntf_type": "subscription",
                "supports_topic": true,
                "default_email": true,
                "title_template": "Subscription expired",
                "body_template": "A {tier_name} subscription has expired.",
                "link_template": "/admin/admin_subscription_tiers"
            }
        }
    }
}
