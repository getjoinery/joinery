# From both repos - combined and deduplicated
composer.phar
/vendor/
.syncconfig-joinery-working

# Database dumps and backups
*.sql
*.sql.gz
*.sql.gz.enc
*.bak

# Site-specific config (from membership)
Globalvars_site.php

# Cache directory
/cache

# Claude settings (local development)
.claude/

# Agent release artifact - regenerated by any publish from the joinery-agent
# source checkout; binaries stay out of git
# The signed agent artifact. It lives in CORE, not in the server_manager plugin:
# every node must receive it, and no plugin may arrive as a side effect of a core
# upgrade (the open-core rule manifest_licensing_test pins). server_manager is
# commercial and entitlement-gated, so it cannot be the carrier.
public_html/agent_dist/

# The publisher's swap leavings. agent_dist is replaced by moving the previous
# bundle to agent_dist.old and the new one into place; a .old that cannot be
# removed (one left root-owned by a publish that ran as root) otherwise sits in
# the tree as 10MB of untracked, still-signed, superseded binaries waiting for
# somebody's `git add -A`. Ignored so a transient can never become a commit.
public_html/agent_dist.*

# Prebuilt relay-sealer binaries - cross-compiled into the mailbox plugin by
# RelaySealerPublisher on every publish that needs them. They SHIP (the plugin
# archive tars the live directory, which git does not gate) but they are build
# output, regenerated from the tracked .go sources beside them.
public_html/plugins/mailbox/provisioning/bin/

# Data directories (not tracked in git)
/backups/
/logs/
/static_files/
/storage/
/uploads/
/docs/api_documentation.md

# Agent instruction files — managed in the database (agf_agent_files table),
# generated to disk by update_database. Not tracked in git.
public_html/CLAUDE.md
public_html/GEMINI.md
public_html/AGENTS.md
public_html/*.md.old

# REMOVED these lines since theme/plugins are now tracked in repo:
# /theme
# /plugins

# Email-security-scan model eval — local-only dev tooling and corpus data.
# Kept out of the repo until the eval process settles (corpus contains real
# phishing samples; the scripts are eval harnesses, not product code). The
# spec itself IS tracked, like every other spec.
#
# Listed file by file rather than by directory: tests/tools/ also holds
# generators for committed test fixtures, which have to travel with the tests
# that assert against them.
public_html/tests/tools/fetch_phishing_pot.php
public_html/tests/tools/fetch_spamassassin_ham.php
public_html/tests/tools/load_email_corpus.php
public_html/tests/tools/score_email_corpus.php
public_html/tests/fixtures/email_security_corpus/

# Relay SSH identities (deployment-generated, never committed)
/config/relay_pull_key
/config/relay_pull_key.pub
/config/relay_test_key
/config/relay_test_key.pub

# Site config dir: per-environment secrets (Globalvars_site.php, SSH identities,
# provisioning keys) - nothing in it is ever committed
/config/

# Site-specific content seeders (content_pack_feature.md, deferred). These build
# one deployment's pages, menus and redirects in its database. They are operator
# tools on the same plane as backup files: never committed, and outside
# public_html so no release archive can carry one site's copy to another's install.
/content_packs/
RELEASE_MANIFEST
RELEASE_MANIFEST.sig
