<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ScrollDaddy app entitlements. Both Network Extension provider types the app
  drives: dns-settings (standard mode, NEDNSSettingsManager) and
  packet-tunnel-provider (strict mode, the tunnel it installs). The app group
  is the shared container the app and the tunnel extension exchange the
  hard-block list through. Requires a paid Apple Developer Program membership.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>dns-settings</string>
        <string>packet-tunnel-provider</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.app.scrolldaddy.ios</string>
    </array>
</dict>
</plist>
