# Joinery Docker Template
# VERSION 4.5 - Detect the PostgreSQL config path and the php-fpm service at
#               start instead of naming a version. Both were pinned, and both
#               sit in the start command's && chain, so on a host with any
#               other PostgreSQL or PHP the container aborted before Apache
#               ever came up. Each now fails with a message naming what it
#               could not find.
# VERSION 4.4 - Re-assert the source's declared PHP extensions on every start,
#               before update_database. They are apt packages in the writable
#               layer (utils/upgrade.php installs them there), so recreating a
#               container dropped them: composer validation failed,
#               update_database was skipped, and the site served happily on an
#               unmigrated schema with nothing in the log to say why.
# VERSION 4.3 - Site code is mounted from named volumes at run time
#               (public_html, vendor, maintenance_scripts). The COPY steps
#               below still put a release in the image, but only as the seed
#               Docker seeds an EMPTY volume from — a populated volume is left
#               untouched, so an in-place upgrade survives container recreation
#               and a stale image cannot overwrite a newer site. The CMD fails
#               loudly when the code path is empty rather than serving an
#               empty site. Spec container_rebuild_never_downgrades.
# VERSION 4.2 - Default BASE_IMAGE_VERSION 1.1 -> 1.2. The fpm module switch
#               lives in install.sh do_server_setup, which the base image
#               bakes, so starting fpm here only serves PHP through it once
#               the base is rebuilt at 1.2.
# VERSION 4.1 - Start php8.3-fpm in the container CMD: PHP serves via fpm
#               (event MPM + proxy_fcgi), never mod_php — the AI chat async
#               turn path needs fastcgi_finish_request(), fpm-only.
# VERSION 4.0 - Declared-dependency install at build + generic plugin host
#               installers at start (spec plugin_dependency_installation).
#               A build step installs every PHP extension the source declares
#               (root composer.json ext-* + plugin requires.extensions) via
#               utils/list_dependencies.php --apt, so the hardcoded base list
#               can no longer drift from the code. The CMD now runs
#               _plugin_installers_start.sh, which executes EVERY active
#               plugin's declared host_installer (replaces the mailbox-only
#               _mail_stack_start.sh). The start-time chown now also covers
#               vendor/ so activation-time composer reconcile (www-data) can
#               write it.
# VERSION 3.9 - Re-assert the Inbound Email mail stack on every container start
#               via _mail_stack_start.sh - postfix/opendkim have no systemd here,
#               so the CMD is what brings them back after a stop/start or rebuild.
#               BASE_IMAGE_VERSION default bumped to 1.1. Spec mail_stack_container_persistence.
# VERSION 3.8 - Extend chown to cover cache/ so static_pages subdirectory created by
#               _site_init.sh is owned by www-data (was root, disabling static page cache).
# VERSION 3.7 - Rename _reconcile_stock_assets.sh -> _reconcile_upgradable_assets.sh
#               as part of the is_stock -> receives_upgrades terminology cleanup.
# VERSION 3.6 - Self-heal ownership on every container start. COPY at build time
#               leaves public_html and maintenance_scripts owned by root, and
#               _site_init.sh's chown only runs on first boot (gated by absence
#               of Globalvars_site.php). On image rebuilds the config volume
#               survives, so _site_init.sh skips, leaving root-owned trees that
#               break upgrade.php's ownership pre-flight. Now we chown to
#               www-data:www-data unconditionally before apache starts.
# VERSION 3.5 - Enable mod_remoteip and switch access-log %h -> %a so PHP and
#               access logs see the real client IP from the host's X-Forwarded-For
#               header instead of the docker bridge gateway (172.17.0.1).
# VERSION 3.4 - Add default to ARG BASE_IMAGE_VERSION so BuildKit can statically
#               evaluate FROM without --build-arg (silences InvalidDefaultArgInFrom warning).
# VERSION 3.3 - Write logrotate config on every container start (was first-run-only via _site_init.sh);
#               rename _sync_stock_assets.sh -> (now _reconcile_upgradable_assets.sh) to reflect its narrow purpose
#
# Usage:
#   docker build \
#     --build-arg BASE_IMAGE_VERSION=1.1 \
#     --build-arg SITENAME=clientsite \
#     --build-arg POSTGRES_PASSWORD=secure_password \
#     --build-arg DOMAIN_NAME=client.example.com \
#     -t joinery-clientsite .
#
# Build Arguments:
#   BASE_IMAGE_VERSION - joinery-base image tag to build from (required)
#   SITENAME          - Site directory name (default: dockertest)
#   POSTGRES_PASSWORD - Database password (required)
#   DOMAIN_NAME       - Domain for VirtualHost (default: localhost)
#
# Runtime Environment Variables (for cloning):
#   CLONE_FROM        - URL to clone database and uploads from (optional)
#   CLONE_KEY         - Authentication key for clone source (optional)

# BASE_IMAGE_VERSION must be declared before FROM so it can be used in FROM.
# Default matches the version install.sh always passes via --build-arg; the
# default only exists to satisfy BuildKit's static-evaluation check.
ARG BASE_IMAGE_VERSION=1.2
FROM joinery-base:${BASE_IMAGE_VERSION}

# Build arguments (customizable per deployment)
ARG SITENAME=dockertest
ARG POSTGRES_PASSWORD
ARG DOMAIN_NAME=localhost

# Set as environment variables for runtime
ENV DEBIAN_FRONTEND=noninteractive
ENV SITENAME=${SITENAME}
ENV POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ENV DOMAIN_NAME=${DOMAIN_NAME}

# Copy source files
# System dependencies (Apache, PHP, PostgreSQL, Composer, cron) come from joinery-base.
#
# public_html, vendor and maintenance_scripts are each mounted from a named
# volume at run time. What is copied here is therefore a seed, not the code the
# site serves: Docker fills an empty volume from the image on first use and
# ignores the image entirely once the volume has content. So this copy builds a
# brand new site, and is inert for every rebuild after that.
COPY ${SITENAME}/ /var/www/html/${SITENAME}/
COPY maintenance_scripts/ /var/www/html/${SITENAME}/maintenance_scripts/

# Ensure install_tools scripts remain executable (they are copied from host
# filesystem and execute bits may not carry over consistently).
RUN chmod +x /var/www/html/${SITENAME}/maintenance_scripts/install_tools/*.sh

# Install every PHP extension the source declares (root composer.json ext-*
# plus plugin requires.extensions). The resolver emits "primary|fallback" apt
# package pairs; a missing package is a warning, not a build failure - the
# plugin activation gate is the runtime backstop.
RUN if [ -f "/var/www/html/${SITENAME}/public_html/utils/list_dependencies.php" ]; then \
        apt-get update -qq && \
        for spec in $(php "/var/www/html/${SITENAME}/public_html/utils/list_dependencies.php" --apt); do \
            primary="${spec%%|*}"; fallback="${spec##*|}"; \
            apt-get install -y "$primary" 2>/dev/null || apt-get install -y "$fallback" || \
                echo "WARNING: could not install $primary (or $fallback)"; \
        done && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# Install Composer dependencies (vendor-dir is ../vendor relative to public_html per composer.json)
RUN if [ -f "/var/www/html/${SITENAME}/public_html/composer.json" ]; then \
        cd /var/www/html/${SITENAME}/public_html && composer install --no-dev --no-interaction 2>/dev/null || true; \
    fi

# Create VirtualHost configuration during build (persists across restarts)
RUN cp /var/www/html/${SITENAME}/maintenance_scripts/install_tools/default_virtualhost.conf /etc/apache2/sites-available/${SITENAME}.conf && \
    sed -i "s/{{SERVER_IP}}/*/g" /etc/apache2/sites-available/${SITENAME}.conf && \
    sed -i "s/{{DOMAIN_NAME}}/${DOMAIN_NAME}/g" /etc/apache2/sites-available/${SITENAME}.conf && \
    sed -i "s/{{SITE_NAME}}/${SITENAME}/g" /etc/apache2/sites-available/${SITENAME}.conf && \
    mkdir -p /var/www/html/${SITENAME}_test/public_html && \
    mkdir -p /var/www/html/${SITENAME}_test/logs && \
    a2dissite 000-default.conf 2>/dev/null || true && \
    a2ensite ${SITENAME}.conf

# Trust the docker bridge gateway for X-Forwarded-For; everything beyond it
# (Cloudflare, etc.) is handled by the host proxy, not here. Write the .conf
# BEFORE a2enmod so the symlink for it is created alongside .load.
RUN printf '%s\n' \
      'RemoteIPHeader X-Forwarded-For' \
      'RemoteIPInternalProxy 172.17.0.0/16' \
      'RemoteIPInternalProxy 127.0.0.1' \
      > /etc/apache2/mods-available/remoteip.conf && \
    a2enmod remoteip && \
    sed -i 's/%h /%a /' /etc/apache2/apache2.conf

# Expose ports
EXPOSE 80 5432

# Use bash for CMD (required for set +H to disable history expansion)
SHELL ["/bin/bash", "-c"]

# Start services
# On first run: _site_init.sh creates database and configures site
# CRITICAL: All variables must be quoted to handle special characters in passwords
# set +H disables history expansion so ! in passwords works correctly
CMD set +H && \
    echo "Container starting: SITENAME=${SITENAME}, DOMAIN=${DOMAIN_NAME}" && \
    if [ -z "${SITENAME}" ]; then echo "FATAL: SITENAME is empty"; exit 1; fi && \
    if [ -z "${POSTGRES_PASSWORD}" ]; then echo "FATAL: POSTGRES_PASSWORD is empty"; exit 1; fi && \
    if [ ! -f "/var/www/html/${SITENAME}/public_html/VERSION" ]; then \
        echo "FATAL: no site code at /var/www/html/${SITENAME}/public_html"; \
        echo "       The code volume is mounted but empty. Seed it from a release"; \
        echo "       archive, or reinstall this site with install.sh."; \
        exit 1; \
    fi && \
    service postgresql start && \
    sleep 3 && \
    export PGPASSWORD="${POSTGRES_PASSWORD}" && \
    PG_CONF="$(ls -1d /etc/postgresql/*/main/pg_hba.conf 2>/dev/null | sort -V | tail -1)" && \
    if [ -z "${PG_CONF}" ]; then echo "FATAL: no pg_hba.conf under /etc/postgresql"; exit 1; fi && \
    if [ ! -f "/var/www/html/${SITENAME}/config/Globalvars_site.php" ]; then \
        sed -i 's/local   all             postgres                                md5/local   all             postgres                                trust/' "$PG_CONF" && \
        service postgresql reload && \
        su -c "psql -c \"ALTER USER postgres PASSWORD '${POSTGRES_PASSWORD}';\"" postgres && \
        sed -i 's/local   all             postgres                                trust/local   all             postgres                                md5/' "$PG_CONF" && \
        service postgresql reload; \
    fi && \
    CLONE_OPTS="" && \
    if [ -n "${CLONE_FROM}" ] && [ -n "${CLONE_KEY}" ]; then \
        CLONE_OPTS="--clone-from=${CLONE_FROM} --clone-key=${CLONE_KEY}"; \
    fi && \
    ([ -f "/var/www/html/${SITENAME}/config/Globalvars_site.php" ] || \
        (cd "/var/www/html/${SITENAME}/maintenance_scripts/install_tools" && \
        ./_site_init.sh "${SITENAME}" "${POSTGRES_PASSWORD}" "${DOMAIN_NAME}" --docker-mode ${CLONE_OPTS})) && \
    chown -R www-data:www-data "/var/www/html/${SITENAME}/public_html" "/var/www/html/${SITENAME}/maintenance_scripts" "/var/www/html/${SITENAME}/cache" && \
    ([ -d "/var/www/html/${SITENAME}/vendor" ] && chown -R www-data:www-data "/var/www/html/${SITENAME}/vendor" || true) && \
    find "/var/www/html/${SITENAME}/public_html" -type d -exec chmod 755 {} + && \
    find "/var/www/html/${SITENAME}/public_html" -type f -exec chmod 644 {} + && \
    bash "/var/www/html/${SITENAME}/maintenance_scripts/install_tools/_install_declared_dependencies.sh" "/var/www/html/${SITENAME}/public_html" || true && \
    php "/var/www/html/${SITENAME}/public_html/utils/update_database.php" 2>/dev/null || true && \
    bash "/var/www/html/${SITENAME}/maintenance_scripts/install_tools/_reconcile_upgradable_assets.sh" || true && \
    echo "*/5 * * * * www-data php /var/www/html/${SITENAME}/public_html/utils/process_scheduled_tasks.php >> /var/www/html/${SITENAME}/logs/cron_scheduled_tasks.log 2>&1" > /etc/cron.d/scheduled-tasks && \
    chmod 644 /etc/cron.d/scheduled-tasks && \
    echo "" >> /etc/cron.d/scheduled-tasks && \
    echo "0 2 * * * root /usr/sbin/logrotate /etc/logrotate.d/joinery-${SITENAME} > /dev/null 2>&1" > /etc/cron.d/logrotate-joinery && \
    chmod 644 /etc/cron.d/logrotate-joinery && \
    echo "" >> /etc/cron.d/logrotate-joinery && \
    sed "s|{{SITE_ROOT}}|/var/www/html/${SITENAME}|g" "/var/www/html/${SITENAME}/maintenance_scripts/install_tools/logrotate_joinery.conf" > "/etc/logrotate.d/joinery-${SITENAME}" && \
    chmod 644 "/etc/logrotate.d/joinery-${SITENAME}" && \
    service cron start && \
    FPM_SERVICE="$(basename "$(ls -1 /etc/init.d/php*-fpm 2>/dev/null | sort -V | tail -1)")" && \
    if [ -z "${FPM_SERVICE}" ] || [ "${FPM_SERVICE}" = "." ]; then echo "FATAL: no php-fpm init script under /etc/init.d"; exit 1; fi && \
    service "${FPM_SERVICE}" start && \
    bash "/var/www/html/${SITENAME}/maintenance_scripts/install_tools/_plugin_installers_start.sh" "${SITENAME}" || true && \
    apache2ctl -D FOREGROUND
