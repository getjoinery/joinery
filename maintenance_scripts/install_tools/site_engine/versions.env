# site_engine/versions.env - the site container engine's parts, each by upstream
# tag and the commit that tag names (specs/site_container_engine.md D1).
#
# build.sh refuses a checkout that is not its commit. Changing any line here is
# what makes the next publish build and ship a new engine; bump the parts
# together when upstream's release notes pair them (Podman 6.x with netavark
# and aardvark-dns 2.x).

PODMAN_REPO="https://github.com/podman-container-tools/podman.git"
PODMAN_TAG="v6.1.4"
PODMAN_COMMIT="464c15fec06f0074c916f9eff87c4806869c2833"

NETAVARK_REPO="https://github.com/containers/netavark.git"
NETAVARK_TAG="v2.1.0"
NETAVARK_COMMIT="8e91ad1d947ed325327b638f0cb906bea1f7d0ab"

AARDVARK_REPO="https://github.com/containers/aardvark-dns.git"
AARDVARK_TAG="v2.1.0"
AARDVARK_COMMIT="cd7417681229219059939bdd9f0b3bd9ac9abb08"

# The Go toolchain podman is compiled with: the official release, fetched by Go
# itself from proxy.golang.org and checked against sum.golang.org (Ubuntu's own
# Go only fetches it). Ubuntu's golang-1.26 is 1.26.0, without the standard
# library's later security fixes, which are compiled into the binary.
GO_TOOLCHAIN="go1.26.9"

# seccomp and apparmor are required (build.sh checks the binary carries them);
# btrfs is left out because the hosts' storage is overlay on XFS.
PODMAN_BUILDTAGS="seccomp systemd apparmor exclude_graphdriver_btrfs"
